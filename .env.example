# Copy this file's values from your own Supabase and Stripe projects.
# Nothing here is committed — .env is gitignored.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Stripe → Developers → API keys (test mode)
VITE_STRIPE_PUBLISHABLE_KEY=

# Server-side only. Mirror these into Supabase Edge Function secrets with
#   supabase secrets set --project-ref <ref> STRIPE_SECRET_KEY=... STRIPE_WEBHOOK_SECRET=...
# STRIPE_WEBHOOK_SECRET comes from Stripe → Developers → Webhooks after you add
# the endpoint https://<ref>.supabase.co/functions/v1/stripe-webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
